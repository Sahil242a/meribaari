PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/meribaari
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# used inside SMS links
PUBLIC_URL=http://localhost:5173
TZ_NAME=Asia/Kolkata

# console (prints SMS to the terminal) | twilio-sms | twilio-whatsapp
NOTIFY_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# true when served over HTTPS (defaults to true in production)
COOKIE_SECURE=

# Optional: force DNS servers for Atlas lookups if your network blocks them
# DNS_SERVERS=8.8.8.8,1.1.1.1
